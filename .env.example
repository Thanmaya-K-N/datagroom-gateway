# Datagroom Gateway Environment Variables

# Database
DATABASE=mongodb://localhost:27017

# Server Port
PORT=8887

# Ollama Configuration (Local LLM)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Embedding Service (sentence-transformers)
EMBEDDING_SERVICE_URL=http://localhost:5001

# Groq API (Commented out - using Ollama)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# GROQ_ROUTER_MODEL=qwen/qwen3-32b

# JIRA Integration (if used)
# JIRA_HOST=https://jira.yourcompany.com
# JIRA_USER=user
# JIRA_PASSWORD=password
