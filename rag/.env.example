# RAG System Environment Variables
# Configuration for refactored dual-LLM architecture with bounded row grounding

# ============================================================================
# GROQ API CONFIGURATION
# ============================================================================
# Get your API key from: https://console.groq.com/
# Model: qwen3-32b (for routing and aggregation generation)
# Leave empty to fall back to Ollama for all tasks

GROQ_API_KEY=

# Feature flags: Use Groq for specific tasks (requires GROQ_API_KEY)
USE_GROQ_FOR_ROUTING=false          # true = Groq, false = Ollama
USE_GROQ_FOR_AGGREGATION=false      # true = Groq, false = Ollama

# ============================================================================
# OLLAMA CONFIGURATION
# ============================================================================
# Local LLM for semantic and hybrid explanations
# Install Ollama from: https://ollama.ai
# Then run: ollama pull llama3.2

OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Temperature for explanations (0.0 = deterministic, 1.0 = creative)
OLLAMA_EXPLANATION_TEMPERATURE=0.35

# ============================================================================
# MONGODB CONFIGURATION
# ============================================================================
# MongoDB connection string
DATABASE=mongodb://localhost:27017

# Database name (if null, uses datasetId from request)
MONGO_DB=

# Aggregation execution limits
MAX_AGGREGATION_LIMIT=500           # Max rows from aggregation
MAX_AGGREGATION_TIMEOUT_MS=10000    # 10 second timeout

# ============================================================================
# HYBRID ROW GROUNDING (NEW FEATURE)
# ============================================================================
# Enable bounded row fetching for hybrid explanations
# When true: Hybrid queries fetch max 10 example rows for LLM grounding
# When false: Hybrid queries use only aggregation results (old behavior)

ENABLE_HYBRID_ROW_GROUNDING=true

# Note: Hard limits are enforced in mongoRowFetcher.js:
# - ABSOLUTE_MAX_ROWS = 10
# - DEFAULT_MAX_ROWS = 5
# - MAX_TIMEOUT_MS = 5000

# ============================================================================
# CHROMADB & EMBEDDING SERVICE
# ============================================================================
# Python embedding microservice (sentence-transformers)
EMBEDDING_SERVICE_URL=http://localhost:5001

# ChromaDB storage path (managed automatically)
CHROMA_DB_PATH=./data/chromadb

# ============================================================================
# LOGGING & DEBUG
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable verbose RAG logging (useful for debugging)
DEBUG_RAG=false

# ============================================================================
# PRODUCTION SETTINGS (RECOMMENDED)
# ============================================================================
# For production deployment, use these settings:
#
# GROQ_API_KEY=gsk_your_production_key_here
# USE_GROQ_FOR_ROUTING=true
# USE_GROQ_FOR_AGGREGATION=true
# ENABLE_HYBRID_ROW_GROUNDING=true
# OLLAMA_API_URL=http://ollama-service:11434
# DATABASE=mongodb://mongodb-prod:27017
# LOG_LEVEL=warn
#
# ============================================================================
